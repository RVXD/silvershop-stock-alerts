$ShopName

<%t SilverShop\StockAlerts.ConfirmGreeting "Confirm your back-in-stock alert" %>

<%t SilverShop\StockAlerts.ConfirmInstruction "Please confirm you'd like one email when {product} is back in stock." product=$BuyableTitle %>

<%t SilverShop\StockAlerts.ConfirmButton "Confirm my alert" %>: $ConfirmLink

<%t SilverShop\StockAlerts.ConfirmIgnore "If you didn't request this, you can safely ignore this email, or" %> $UnsubscribeLink
